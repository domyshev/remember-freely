ADDRESS=:8080
DATABASE_PATH=data/practice.db
STATIC_DIR=dist
SESSION_SECRET=replace-with-at-least-32-random-bytes
COOKIE_SECURE=false

# log prints login codes to the backend console; resend sends real email.
EMAIL_MODE=log
RESEND_API_KEY=
EMAIL_FROM=Remember Freely <login@example.com>

CONTENT_DIR=data/content

# Private account snapshots and transient uploads; default: beside SQLite.
IMPORT_DIR=data/account-content
